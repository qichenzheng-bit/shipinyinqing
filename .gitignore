# Private deployment secrets / local runtime
.env
.env.*
!.env.example
config/edit_ai.json
config/*.secret.json
*.pem
*.key
.weiguang_data/
data/
__pycache__/
.pytest_cache/
*.py[cod]
.DS_Store

# Native Windows desktop release (regenerated by CI)
desktop/node_modules/
desktop/dist/
desktop/build/
desktop/.cache/
desktop/.electron-cache/
npm-debug.log*
.vs/
.vscode/
*.tmp
# Never track real production credentials or database media.
local-secrets.bin
launcher.json

# Android builds, local SDK configuration and release signing (never commit)
android_app/.gradle/
android_app/.idea/
android_app/build/
android_app/app/build/
android_app/local.properties
android_app/screenshots/
*.apk
*.aab
*.jks
*.keystore
