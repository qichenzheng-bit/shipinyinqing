# Private deployment secrets / local runtime
.env
.env.*
!.env.example
config/edit_ai.json
config/*.secret.json
*.pem
*.key
.weiguang_data/
data/
__pycache__/
.pytest_cache/
*.py[cod]
.DS_Store

# Native Windows desktop release (regenerated by CI)
desktop/node_modules/
desktop/dist/
desktop/build/
desktop/.cache/
desktop/.electron-cache/
npm-debug.log*
.vs/
.vscode/
*.tmp
# Never track real production credentials or database media.
local-secrets.bin
launcher.json

# Reproducible CI evidence and throwaway build/test output.
# Browser/native screenshots are uploaded as CI artifacts, not committed.
frontend/screenshots/
desktop/screenshots/
final-output/
v27-script/
media/
*.mp4
*.mov
*.wav
*.mp3
*.flac
*.srt
*.zip
*.exe
*.msi
*.apk
*.aab

# No Linux or macOS end-user installable artifacts in Windows-only source.
linux/
*.AppImage
*.deb
*.rpm
*.snap
*.dmg
*.pkg

# Legacy local database files are never checked into source control.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
