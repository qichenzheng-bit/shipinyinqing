# Reverse proxy for a private WeiGuang Mathematics studio.
# Bind the application API only to loopback. Use an actual TLS certificate
# before making the site public; never copy example domain or secrets as-is.
server {
    listen 80;
    server_name YOUR_DOMAIN.example;
    client_max_body_size 70m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }
}
