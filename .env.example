# Create .env locally; never commit real credentials.
# Windows app + Docker Desktop / WSL2: PostgreSQL 17 is mandatory.
# Compose injects DATABASE_URL for the API and worker automatically.
# No local file database or embedded database fallback exists.
POSTGRES_PASSWORD=CHANGE_ME_TO_URL_SAFE_RANDOM_PASSWORD
WEIGUANG_API_TOKEN=CHANGE_ME_TO_LONG_RANDOM_PRIVATE_TOKEN
WEIGUANG_TEACHER_ENABLED=0
MATH_TEACHER_MODEL=
MATH_TEACHER_BASE_URL=https://api.openai.com/v1
MATH_TEACHER_API_KEY=
WEIGUANG_EDIT_AI_ENABLED=0
WEIGUANG_EDIT_AI_KEY=
WEIGUANG_MATH_REVIEWER=
WEIGUANG_SCRIPT_REVIEWER=

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this unchanged while saved providers exist; do NOT commit the real key.
WEIGUANG_MODEL_MASTER_KEY=
# Only set 1 for trusted local Ollama / LM Studio / private network.
WEIGUANG_ALLOW_PRIVATE_MODEL_ENDPOINTS=0
